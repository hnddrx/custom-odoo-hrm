<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="update_info_form_view" model="ir.ui.view">
        <field name="name">update.info.form</field>
        <field name="model">update.info</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <div class="oe_header oe_background oe_padding">
                        <!-- Workflow and Approval Flow -->
                        <group class="oe_inline">
                            <!-- Hidden Fields -->
                            <field name="work_flow" widget="many2one" placeholder="Select Workflow" invisible="1"/>
                            <field name="module_approval_flow" invisible="1">
                                <tree editable="bottom">
                                    <field name="module_approver_name" 
                                        widget="many2one" 
                                        options="{'no_create': True}" 
                                        placeholder="Approver Name" />
                                    <field name="module_approver_email" 
                                        widget="email" 
                                        placeholder="Approver Email" />
                                    <field name="module_approval_status" 
                                        placeholder="Approval Status"/>
                                    <field name="module_doc_status" />
                                    <field name="module_approval_sequence" 
                                        placeholder="Approval Sequence"/>
                                    <field name="module_approval_date" 
                                        widget="datetime" 
                                        placeholder="Approval Date"/>w
                                    <field name="module_approval_confirmed" 
                                        widget="boolean"/>
                                </tree>
                            </field>
                            <field name="can_approve" invisible="1"/>
                            <field name="can_reject" invisible="1"/>
                            <field name="can_cancel" invisible="1"/>
                            <field name="current_sequence" invisible="1"/>
                            <field name="current_docstatus" invisible="1" />  
                        </group>
                        
                        <!-- Action Buttons and Status -->
                        <div style="width: 100%;">
                            <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                <!-- Submit and Approve Buttons -->
                                <div style="display: flex; gap: 10px;">
                                    <button name="action_submit" 
                                            string="Submit" 
                                            type="object" 
                                            class="oe_highlight" 
                                            icon="fa-paper-plane" 
                                            invisible="status != 'Draft'" 
                                            style="padding: 8px 16px; font-size: 14px; border-radius: 4px;"/>
                                    
                                    <button name="action_approve" 
                                            string="Approve" 
                                            type="object" 
                                            class="oe_highlight" 
                                            icon="fa-check-circle" 
                                            invisible="not can_approve or current_docstatus not in (1, 2)"
                                            style="padding: 8px 16px; font-size: 14px; border-radius: 4px;"/>

                                    <button name="action_reject"
                                            string="Reject"
                                            type="object"
                                            class="btn btn-warning btn-sm"
                                            icon="fa-times-circle"
                                            invisible="not can_reject or status == 'Rejected'"
                                            style="font-size: 14px; border-radius: 4px; padding: 6px 12px;"/>

                                    <button name="action_cancel"
                                            string="Cancel"
                                            type="object"
                                            class="btn btn-danger btn-sm"
                                            icon="fa-times-circle"
                                            invisible="not can_cancel or status == 'Cancelled'"
                                            style="font-size: 14px; border-radius: 4px; padding: 6px 12px;"/>

                                </div>

                                <!-- Status Badge -->
                                <div>
                                    <field name="status" 
                                        widget="badge" 
                                        decoration-info="current_docstatus == 1" 
                                        decoration-success="current_docstatus == 2"
                                        decoration-warning="current_docstatus == 3"
                                        decoration-danger="current_docstatus == 4"
                                        style="font-size: 14px; font-weight: bold; padding: 6px 12px; border-radius: 4px;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>
                <sheet>
                    <group name="default_view">
                        <group name="default_view_left">
                            <field name="employee_id"/>
                            <field name="department_id" readonly="True" force_save="True"/>
                        </group>
                        <group name="default_view_right">
                            <field name="company_id" readonly="True" force_save="True"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                    <field name="update_detail" readonly="current_docstatus in [1,2,3,4,5]">
                        <tree string="Update Detail" editable="bottom">
                            <field name="field_id" required="True"/>
                            <field name="old_value" readonly="True" force_save="True"/>
                            <field name="new_value"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="update_info_tree_view" model="ir.ui.view">
        <field name="name">update.info.tree</field>
        <field name="model">update.info</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="update_info_action" model="ir.actions.act_window">
        <field name="name">Employee Info Update</field>
        <field name="res_model">update.info</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Use this interface to log and manage all information update records. Click "New" to create a new entry.
            </p>
        </field>        
    </record>


    <!-- Module Approval Flow Tree View -->
    <record id="view_module_approval_flow_tree" model="ir.ui.view">
        <field name="name">update.approval.flow.tree</field>
        <field name="model">update.approval.flow</field>
        <field name="arch" type="xml">
            <tree string="Module Approval Flow">
                <field name="module_approver_name"/>
                <field name="module_approval_status"/>
            </tree>
        </field>
    </record>

    <menuitem
        id="menu_update_info_action"
        name="Employee Info Update"
        action="update_info_action"
        sequence="25"
        web_icon="employee_info_update,static/src/description/updated.png"/>

</odoo>